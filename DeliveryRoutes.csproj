<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeliveryRoutes</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Copia los archivos de datos a bin\Debug\net9.0 para que funcione al ejecutar desde Visual Studio -->
  <ItemGroup>
    <None Include="city.txt;packages.txt;city_mini.txt;packages_mini.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
